# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olrac_db

# ── JWT ──
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── SMTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Olrac

# Booking OTP
BOOKING_OTP_TTL_SECONDS=120
BOOKING_OTP_VERIFIED_TTL_SECONDS=1800
BOOKING_OTP_MAX_ATTEMPTS=5

# Admin password reset OTP
ADMIN_RESET_OTP_TTL_SECONDS=600
ADMIN_RESET_OTP_VERIFIED_TTL_SECONDS=1800
ADMIN_RESET_OTP_MAX_ATTEMPTS=5

# Default admin bootstrap
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@olrac.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_COMPANY=Olrac Adverse
DEFAULT_ADMIN_SYNC_PASSWORD=false

# ── Groq AI ──
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# ── WhatsApp ──
WHATSAPP_ADMIN_NUMBER=919876543210

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://olrac.com,https://www.olrac.com,https://admin.olrac.com
